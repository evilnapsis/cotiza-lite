{% extends "layouts/main.html.twig" %}
{% block title %}Ajustes de la Empresa{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">Ajustes Generales</h2>
        <span class="text-muted">Configuración comercial, fiscal y logotipo de la empresa</span>
    </div>
</div>

<div class="card shadow-sm border-0 col-lg-8">
    <div class="card-header bg-white py-3">
        <h5 class="card-title mb-0 fw-bold"><i class="bi bi-building me-2 text-primary"></i>Datos de la Empresa y Membrete</h5>
    </div>
    <div class="card-body p-4">
        <form method="POST" action="{{ base_url }}/settings/update" enctype="multipart/form-data">
            {{ csrf_field() }}

            <div class="row g-3">
                <div class="col-md-12">
                    <label class="form-label fw-semibold">Nombre de la Empresa / Razón Social</label>
                    <input type="text" name="general_company" class="form-control" value="{{ settings.general_company }}" placeholder="Mi Empresa S.A. de C.V.">
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">RFC</label>
                    <input type="text" name="general_rfc" class="form-control" value="{{ settings.general_rfc }}" placeholder="XAXX010101000">
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Teléfono de Contacto</label>
                    <input type="text" name="general_phone" class="form-control" value="{{ settings.general_phone }}" placeholder="(993) 123-4567">
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Email de Contacto</label>
                    <input type="email" name="general_email" class="form-control" value="{{ settings.general_email }}" placeholder="contacto@empresa.com">
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Dirección Comercial</label>
                    <input type="text" name="general_address" class="form-control" value="{{ settings.general_address }}" placeholder="Av. Principal #123, Col. Centro">
                </div>

                <div class="col-md-12 pt-3 border-top">
                    <label class="form-label fw-semibold">Logotipo de la Empresa (Membrete PDF)</label>
                    <div class="d-flex align-items-center gap-4">
                        {% if settings.general_logo %}
                            <div class="border p-2 rounded bg-light">
                                <img src="{{ base_url }}/storage/configuration/{{ settings.general_logo }}" alt="Logo actual" style="max-height: 80px; max-width: 180px;">
                            </div>
                        {% endif %}
                        <div class="flex-grow-1">
                            <input type="file" name="general_logo" class="form-control" accept="image/*">
                            <div class="form-text">Formatos recomendados: PNG o JPG con fondo transparente o blanco (máx. 2MB).</div>
                        </div>
                    </div>
                </div>

                <div class="col-md-12 mt-4 text-end">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-save me-1"></i> Guardar Ajustes
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>
{% endblock %}
