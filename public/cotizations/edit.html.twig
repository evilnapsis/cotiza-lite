{% extends "layouts/main.html.twig" %}
{% block title %}Cotización #{{ cotization.id }}{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">Cotización <span class="text-primary">#{{ cotization.id }}</span></h2>
        <span class="text-muted">Fecha de creación: {{ cotization.created_at }}</span>
    </div>
    <div>
        <a href="{{ base_url }}/cotization/{{ cotization.id }}/pdf" target="_blank" class="btn btn-success me-2 fw-semibold">
            <i class="bi bi-printer me-1"></i> Imprimir PDF
        </a>
        <a href="{{ base_url }}/cotizations" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Volver a la Lista
        </a>
    </div>
</div>

<!-- Bloque 1: Cliente y Estado -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3">
        <h5 class="card-title mb-0 fw-bold"><i class="bi bi-person-check me-2 text-primary"></i>Datos Generales</h5>
    </div>
    <div class="card-body">
        <form method="POST" action="{{ base_url }}/cotization/{{ cotization.id }}/update">
            {{ csrf_field() }}
            <div class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label fw-semibold">Cliente</label>
                    <select name="person_id" class="form-select">
                        <option value="">-- SELECCIONE CLIENTE --</option>
                        {% for cli in clients %}
                            <option value="{{ cli.id }}" {% if cotization.person_id == cli.id %}selected{% endif %}>
                                {{ cli.name }} {{ cli.lastname }} {% if cli.rfc %}(RFC: {{ cli.rfc }}){% endif %}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Estado de la Cotización</label>
                    <select name="status_id" class="form-select" required>
                        {% for st in statuses %}
                            <option value="{{ st.id }}" {% if cotization.status_id == st.id %}selected{% endif %}>
                                {{ st.name }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-check2-circle me-1"></i> Actualizar Datos
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Bloque 2: Conceptos / Ítems de la Cotización -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3">
        <h5 class="card-title mb-0 fw-bold"><i class="bi bi-cart-plus me-2 text-primary"></i>Productos y Servicios</h5>
    </div>
    <div class="card-body">
        <!-- Formulario para agregar ítem -->
        <form method="POST" action="{{ base_url }}/cotization/{{ cotization.id }}/item/add" class="mb-4">
            {{ csrf_field() }}
            <div class="row g-3 align-items-end bg-light p-3 rounded">
                <div class="col-md-2">
                    <label class="form-label fw-semibold">Cantidad</label>
                    <input type="number" name="q" class="form-control" value="1" min="0.01" step="any" required>
                </div>

                <div class="col-md-7">
                    <label class="form-label fw-semibold">Servicio / Producto</label>
                    <select name="service_id" class="form-select" required>
                        <option value="">-- SELECCIONE SERVICIO O PRODUCTO --</option>
                        {% for srv in services %}
                            <option value="{{ srv.id }}">
                                {% if srv.code %}[{{ srv.code }}] - {% endif %}{{ srv.name }} - ${{ srv.amount|number_format(2, '.', ',') }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="col-md-3">
                    <button type="submit" class="btn btn-success w-100 fw-semibold">
                        <i class="bi bi-plus-lg me-1"></i> Agregar a Cotización
                    </button>
                </div>
            </div>
        </form>

        <!-- Tabla de ítems -->
        {% if cotization.items|length > 0 %}
            <div class="table-responsive">
                <table class="table table-bordered table-striped align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th style="width: 100px;" class="text-center">Cantidad</th>
                            <th>Descripción del Concepto / Servicio</th>
                            <th style="width: 150px;" class="text-end">Precio Unitario</th>
                            <th style="width: 150px;" class="text-end">Subtotal</th>
                            <th style="width: 80px;" class="text-center"></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in cotization.items %}
                            <tr>
                                <td class="text-center fw-bold">{{ item.q }}</td>
                                <td>
                                    <strong>{{ item.service_name }}</strong>
                                    {% if item.service_code %}
                                        <span class="badge bg-secondary ms-1">{{ item.service_code }}</span>
                                    {% endif %}
                                    {% if item.service_kind %}
                                        <span class="badge bg-light text-dark border ms-1">{{ item.service_kind }}</span>
                                    {% endif %}
                                </td>
                                <td class="text-end">$ {{ item.price|number_format(2, '.', ',') }}</td>
                                <td class="text-end fw-bold text-success">$ {{ item.subtotal|number_format(2, '.', ',') }}</td>
                                <td class="text-center">
                                    <form action="{{ base_url }}/cotization/{{ cotization.id }}/item/{{ item.id }}/delete" method="POST" onsubmit="return confirm('¿Quitar este ítem de la cotización?');">
                                        {{ csrf_field() }}
                                        <button type="submit" class="btn btn-outline-danger btn-sm" title="Quitar ítem">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="alert alert-warning mb-0">
                <i class="bi bi-exclamation-triangle me-2"></i>Aún no has agregado ningún servicio o producto a esta cotización.
            </div>
        {% endif %}
    </div>
</div>

<!-- Bloque 3: Condiciones, Forma de Pago y Total -->
<div class="row g-4">
    <div class="col-md-7">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3">
                <h5 class="card-title mb-0 fw-bold"><i class="bi bi-cash-coin me-2 text-primary"></i>Condiciones y Notas</h5>
            </div>
            <div class="card-body">
                <form method="POST" action="{{ base_url }}/cotization/{{ cotization.id }}/updatenotes">
                    {{ csrf_field() }}

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Forma de Pago</label>
                        <select name="forma_id" class="form-select">
                            <option value="">-- SELECCIONE FORMA DE PAGO --</option>
                            {% for fo in formas %}
                                <option value="{{ fo.id }}" {% if cotization.forma_id == fo.id %}selected{% endif %}>
                                    {{ fo.name }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Comentarios / Observaciones</label>
                        <textarea name="notes" class="form-control" rows="4" placeholder="Términos de entrega, notas sobre el servicio, etc.">{{ cotization.notes }}</textarea>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save me-1"></i> Guardar Condiciones y Notas
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-5">
        <div class="card shadow-sm border-0 bg-primary text-white h-100">
            <div class="card-body d-flex flex-column justify-content-between p-4">
                <div>
                    <h5 class="fw-bold mb-3"><i class="bi bi-calculator me-2"></i>Resumen de la Cotización</h5>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-white-50">Ítems cotizados:</span>
                        <span class="fw-bold">{{ cotization.items|length }}</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-white-50">Cliente:</span>
                        <span class="fw-bold">{{ cotization.client_name }}</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-white-50">Forma de Pago:</span>
                        <span class="fw-bold">{{ cotization.forma_name }}</span>
                    </div>
                </div>

                <div class="mt-4 pt-4 border-top border-white-50">
                    <div class="text-white-50 small text-uppercase fw-bold">Importe Total</div>
                    <div class="display-5 fw-bold text-warning">
                        $ {{ cotization.total|number_format(2, '.', ',') }}
                    </div>
                    <div class="mt-3">
                        <a href="{{ base_url }}/cotization/{{ cotization.id }}/pdf" target="_blank" class="btn btn-light w-100 fw-bold text-primary">
                            <i class="bi bi-printer me-1"></i> Imprimir Cotización Oficial
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
