{% extends "layouts/main.html.twig" %}
{% block title %}Editar Servicio{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">Editar Servicio</h2>
        <span class="text-muted">{{ service.name }}</span>
    </div>
    <a href="{{ base_url }}/services" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Volver a Servicios
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        {% if errors %}
            <div class="alert alert-danger">
                <ul class="mb-0">
                    {% for err in errors %}
                        <li>{{ err }}</li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        <form method="POST" action="{{ base_url }}/service/{{ service.id }}/update">
            {{ csrf_field() }}

            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Código Interno</label>
                    <input type="text" name="code" class="form-control" value="{{ service.code }}" placeholder="SRV-001">
                </div>

                <div class="col-md-8">
                    <label class="form-label fw-semibold">Nombre del Servicio / Concepto <span class="text-danger">*</span></label>
                    <input type="text" name="name" class="form-control" value="{{ service.name }}" required>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Tipo de Servicio</label>
                    <input type="text" name="kind" class="form-control" value="{{ service.kind }}">
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Precio / Costo Unitario <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input type="number" step="0.01" min="0" name="amount" class="form-control" value="{{ service.amount }}" required>
                    </div>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Categoría</label>
                    <select name="category_id" class="form-select">
                        <option value="">-- SELECCIONE CATEGORÍA --</option>
                        {% for cat in categories %}
                            <option value="{{ cat.id }}" {% if service.category_id == cat.id %}selected{% endif %}>{{ cat.name }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="col-md-12 mt-4 text-end">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check-lg me-1"></i> Actualizar Servicio
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>
{% endblock %}
