{% extends "layouts/main.html.twig" %}
{% block title %}Dashboard{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">Panel de Control</h2>
        <span class="text-muted">Resumen ejecutivo del sistema de cotizaciones</span>
    </div>
    <div>
        <a href="{{ base_url }}/cotization/new" class="btn btn-warning fw-semibold">
            <i class="bi bi-plus-circle me-1"></i> Nueva Cotización
        </a>
    </div>
</div>

<!-- Tarjetas de Métricas -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card text-white bg-warning shadow-sm border-0">
            <div class="card-body pb-3 d-flex justify-content-between align-items-start">
                <div>
                    <div class="fs-2 fw-bold text-dark">{{ stats.cotizations_count }}</div>
                    <div class="text-dark fw-semibold">Cotizaciones</div>
                </div>
                <i class="bi bi-file-earmark-text text-dark opacity-50 fs-1"></i>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a href="{{ base_url }}/cotizations" class="text-dark text-decoration-none small fw-semibold">
                    Ver todas <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card text-white bg-primary shadow-sm border-0">
            <div class="card-body pb-3 d-flex justify-content-between align-items-start">
                <div>
                    <div class="fs-2 fw-bold">{{ stats.clients_count }}</div>
                    <div class="text-white-50">Clientes</div>
                </div>
                <i class="bi bi-people text-white-50 fs-1"></i>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a href="{{ base_url }}/clients" class="text-white text-decoration-none small fw-semibold">
                    Ver clientes <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card text-white bg-success shadow-sm border-0">
            <div class="card-body pb-3 d-flex justify-content-between align-items-start">
                <div>
                    <div class="fs-2 fw-bold">{{ stats.services_count }}</div>
                    <div class="text-white-50">Servicios / Productos</div>
                </div>
                <i class="bi bi-box-seam text-white-50 fs-1"></i>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a href="{{ base_url }}/services" class="text-white text-decoration-none small fw-semibold">
                    Ver catálogo <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card text-white bg-info shadow-sm border-0">
            <div class="card-body pb-3 d-flex justify-content-between align-items-start">
                <div>
                    <div class="fs-2 fw-bold">{{ stats.users_count }}</div>
                    <div class="text-white-50">Usuarios</div>
                </div>
                <i class="bi bi-person-badge text-white-50 fs-1"></i>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a href="{{ base_url }}/users" class="text-white text-decoration-none small fw-semibold">
                    Gestionar <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Gráfica de Cotizaciones Vendidas (Últimos 30 Días) -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <h5 class="card-title mb-0 fw-bold">
                <i class="bi bi-bar-chart-line-fill me-2 text-success"></i>Cotizaciones Vendidas (Últimos 30 Días)
            </h5>
            <small class="text-muted">Período: {{ chart_data.start_date }} al {{ chart_data.end_date }}</small>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-success bg-opacity-10 text-success border border-success px-3 py-2 fw-bold fs-6">
                <i class="bi bi-currency-dollar me-1"></i>Total: $ {{ chart_data.total_sold_sum|number_format(2, '.', ',') }}
            </span>
            <span class="badge bg-light text-dark border px-3 py-2 fw-semibold fs-6">
                <i class="bi bi-check-circle-fill me-1 text-success"></i>{{ chart_data.total_sold_count }} Vendidas
            </span>
        </div>
    </div>
    <div class="card-body">
        <div style="height: 300px; width: 100%; position: relative;">
            <canvas id="soldQuotesChart"></canvas>
        </div>
    </div>
</div>

<!-- Últimas Cotizaciones -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0 fw-bold"><i class="bi bi-clock-history me-2 text-primary"></i>Cotizaciones Recientes</h5>
        <a href="{{ base_url }}/cotizations" class="btn btn-outline-primary btn-sm">Ver Listado Completo</a>
    </div>
    <div class="card-body p-0">
        {% if latest|length > 0 %}
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3"># Folio</th>
                            <th>Cliente</th>
                            <th>Total</th>
                            <th>Estado</th>
                            <th>Fecha</th>
                            <th class="text-end pe-3">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for cot in latest %}
                            <tr>
                                <td class="ps-3 fw-bold">
                                    <a href="{{ base_url }}/cotization/{{ cot.id }}/edit" class="text-decoration-none">
                                        #{{ cot.id }}
                                    </a>
                                </td>
                                <td>{{ cot.client_name }}</td>
                                <td class="fw-bold text-success">$ {{ cot.total|number_format(2, '.', ',') }}</td>
                                <td>
                                    <span class="badge badge-status-{{ cot.status_id }} px-2 py-1">
                                        {{ cot.status_name }}
                                    </span>
                                </td>
                                <td>{{ cot.created_at }}</td>
                                <td class="text-end pe-3">
                                    <a href="{{ base_url }}/cotization/{{ cot.id }}/pdf" target="_blank" class="btn btn-outline-secondary btn-sm" title="Imprimir PDF">
                                        <i class="bi bi-printer"></i>
                                    </a>
                                    <a href="{{ base_url }}/cotization/{{ cot.id }}/edit" class="btn btn-warning btn-sm" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="p-4 text-center text-muted">
                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                Aún no hay cotizaciones registradas en el sistema.
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const ctx = document.getElementById('soldQuotesChart');
    if (!ctx) return;

    const labels = {{ chart_data.labels|json_encode()|raw }};
    const amounts = {{ chart_data.amounts|json_encode()|raw }};
    const counts = {{ chart_data.counts|json_encode()|raw }};
    const dates = {{ chart_data.dates|json_encode()|raw }};

    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: labels,
            datasets: [{
                label: 'Total Vendido ($)',
                data: amounts,
                backgroundColor: 'rgba(25, 135, 84, 0.75)',
                borderColor: '#198754',
                borderWidth: 1.5,
                borderRadius: 4,
                borderSkipped: false,
                hoverBackgroundColor: '#157347',
                barPercentage: 0.7,
                categoryPercentage: 0.8
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    display: false
                },
                tooltip: {
                    backgroundColor: 'rgba(33, 37, 41, 0.95)',
                    padding: 12,
                    cornerRadius: 8,
                    titleFont: { size: 13, weight: 'bold' },
                    bodyFont: { size: 12 },
                    callbacks: {
                        title: function(items) {
                            if (!items.length) return '';
                            const idx = items[0].dataIndex;
                            return labels[idx] + ' (' + dates[idx] + ')';
                        },
                        label: function(context) {
                            const val = context.parsed.y || 0;
                            const idx = context.dataIndex;
                            const count = counts[idx] || 0;
                            return [
                                ' Monto Vendido: $ ' + val.toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
                                ' Cotizaciones: ' + count
                            ];
                        }
                    }
                }
            },
            scales: {
                x: {
                    grid: {
                        display: false,
                        drawBorder: false
                    },
                    ticks: {
                        color: '#6c757d',
                        font: { size: 11 },
                        maxRotation: 45,
                        minRotation: 0,
                        autoSkip: true,
                        maxTicksLimit: 15
                    }
                },
                y: {
                    beginAtZero: true,
                    grid: {
                        color: 'rgba(0, 0, 0, 0.06)',
                        drawBorder: false
                    },
                    ticks: {
                        color: '#6c757d',
                        font: { size: 11 },
                        callback: function(value) {
                            return '$ ' + value.toLocaleString('es-MX');
                        }
                    }
                }
            }
        }
    });
});
</script>
{% endblock %}
