{% extends "layouts/main.html.twig" %}
{% block title %}Nueva Forma de Pago{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">Nueva Forma de Pago</h2>
    </div>
    <a href="{{ base_url }}/formas" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Volver a Formas de Pago
    </a>
</div>

<div class="card shadow-sm border-0 col-md-6">
    <div class="card-body p-4">
        {% if errors %}
            <div class="alert alert-danger">{{ errors.name }}</div>
        {% endif %}

        <form method="POST" action="{{ base_url }}/forma/create">
            {{ csrf_field() }}
            <div class="mb-3">
                <label class="form-label fw-semibold">Nombre del Método de Pago <span class="text-danger">*</span></label>
                <input type="text" name="name" class="form-control" value="{{ old.name }}" required placeholder="Ej. Efectivo, Transferencia, Tarjeta">
            </div>
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-save me-1"></i> Guardar Forma de Pago
            </button>
        </form>
    </div>
</div>
{% endblock %}
