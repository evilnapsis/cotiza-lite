<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Iniciar Sesión - COTIZA LITE 2</title>
    <link rel="stylesheet" href="{{ base_url }}/assets/css/style.css">
    <link rel="stylesheet" href="{{ base_url }}/assets/bootstrap-icons/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body class="bg-light min-vh-100 d-flex flex-row align-items-center">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-8">
                <div class="card p-4 shadow-sm border-0">
                    <div class="card-body">
                        <div class="text-center mb-4">
                            <h2 class="fw-bold text-primary mb-1">
                                <i class="bi bi-receipt text-warning me-2"></i>COTIZA LITE 2
                            </h2>
                            <p class="text-muted">Sistema de Gestión de Cotizaciones</p>
                        </div>

                        {% if session.error %}
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                {{ session.error }}
                            </div>
                        {% endif %}

                        <form method="POST" action="{{ base_url }}/login">
                            {{ csrf_field() }}

                            <div class="mb-3">
                                <label class="form-label text-secondary fw-semibold">Usuario o Email</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                                    <input class="form-control" type="text" name="email" placeholder="admin" required autofocus>
                                </div>
                            </div>

                            <div class="mb-4">
                                <label class="form-label text-secondary fw-semibold">Contraseña</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                                    <input class="form-control" type="password" name="password" placeholder="admin" required>
                                </div>
                            </div>

                            <div class="d-grid">
                                <button class="btn btn-primary btn-lg" type="submit">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar Sesión
                                </button>
                            </div>
                        </form>

                        <div class="mt-4 text-center text-muted small">
                            LegoBox v5 Architecture &copy; {{ "now"|date("Y") }} Evilnapsis
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
